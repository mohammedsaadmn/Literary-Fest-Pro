# Port for backend server (Render automatically sets process.env.PORT)
PORT=5000

# MongoDB Connection String (Replace with your MongoDB Atlas connection string in Render environment settings)
MONGO_URI=your_mongodb_atlas_connection_string

# Frontend Client URL for CORS policy in production (e.g., https://your-app.vercel.app or https://your-app.onrender.com)
CLIENT_URL=http://localhost:5173
